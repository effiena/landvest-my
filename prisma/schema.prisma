generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                    Int                     @id @default(autoincrement())
  name                  String
  email                 String                  @unique
  password              String
  plan                  String                  @default("starter")
  createdAt             DateTime                @default(now())
  extraListings         Int                     @default(0)
  listingLimit          Int                     @default(3)
  role                  String                  @default("agent")
  emailVerified         Boolean                 @default(false)
  verifyToken           String?                 @unique
  whatsappNumber        String?
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int                     @default(0)
  legacySharedWhatsApp  Boolean                 @default(false)
  listings              Land[]
  purchases             ListingCreditPurchase[]
  subscription          Subscription?
  wantToBuy             WantToBuy[]             @relation("AssignedWantToBuy")
}

model WantToBuy {
  id                     Int      @id @default(autoincrement())
  buyerName              String
  whatsapp               String
  city                   String
  propertyType           String?
  requiredSize           String?
  budget                 String?
  basicSalary            Float?
  bankCommitment         Float?
  ctosCcrisStatus        String?
  loanTenure             Int?
  interestRate           Float?
  maxDsr                 Float?
  availableMonthly       Float?
  estimatedLoan          Float?
  estimatedPropertyPrice Float?
  additionalRequirements String?
  assignedAgentId        Int?
  status                 String   @default("new")
  createdAt              DateTime @default(now())
  assignedAgent          Agent?   @relation("AssignedWantToBuy", fields: [assignedAgentId], references: [id])
}

model Subscription {
  id        Int       @id @default(autoincrement())
  agentId   Int       @unique
  paypalId  String?   @unique
  status    String    @default("inactive")
  plan      String    @default("starter")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  startedAt DateTime?
  agent     Agent     @relation(fields: [agentId], references: [id])
}

model ListingCreditPurchase {
  id            Int      @id @default(autoincrement())
  agentId       Int
  credits       Int
  amount        Float
  paypalOrderId String?  @unique
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  agent         Agent    @relation(fields: [agentId], references: [id])
}

model Land {
  id          Int         @id @default(autoincrement())
  agentId     Int
  title       String
  location    String
  state       String
  city        String?
  acreage     Float
  price       String
  description String
  whatsapp    String
  createdAt   DateTime    @default(now())
  areaValue   Float?
  areaUnit    String?
  agent       Agent       @relation(fields: [agentId], references: [id])
  images      LandImage[]
}

model LandImage {
  id      Int     @id @default(autoincrement())
  url     String
  isCover Boolean @default(false)
  landId  Int
  land    Land    @relation(fields: [landId], references: [id], onDelete: Cascade)
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
